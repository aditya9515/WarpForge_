{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aditya9515/WarpForge_/blob/main/benchmarks/schema/v1.json",
  "title": "WarpForge benchmark result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "metadata",
    "config",
    "statistics_ms",
    "correctness",
    "metrics",
    "samples_ms"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "implementation",
        "data_type",
        "timing_scope",
        "dimensions",
        "launch",
        "gpu_name",
        "compute_capability",
        "gpu_global_memory_bytes",
        "cuda_driver_version",
        "cuda_runtime_version",
        "build_type",
        "compiler",
        "git_commit",
        "timestamp_utc"
      ],
      "properties": {
        "operation": { "type": "string", "minLength": 1 },
        "implementation": { "type": "string", "minLength": 1 },
        "data_type": { "type": "string", "minLength": 1 },
        "timing_scope": { "enum": ["kernel-only", "end-to-end"] },
        "dimensions": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "launch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["grid", "block", "dynamic_shared_memory_bytes"],
          "properties": {
            "grid": { "$ref": "#/$defs/dim3" },
            "block": { "$ref": "#/$defs/dim3" },
            "dynamic_shared_memory_bytes": { "type": "integer", "minimum": 0 }
          }
        },
        "gpu_name": { "type": "string", "minLength": 1 },
        "compute_capability": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "gpu_global_memory_bytes": { "type": "integer", "minimum": 1 },
        "cuda_driver_version": { "type": "string", "minLength": 1 },
        "cuda_runtime_version": { "type": "string", "minLength": 1 },
        "build_type": { "type": "string", "minLength": 1 },
        "compiler": { "type": "string", "minLength": 1 },
        "git_commit": { "type": "string", "minLength": 1 },
        "timestamp_utc": { "type": "string", "format": "date-time" }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warmup_iterations", "measurement_iterations", "seed"],
      "properties": {
        "warmup_iterations": { "type": "integer", "minimum": 0 },
        "measurement_iterations": { "type": "integer", "minimum": 1 },
        "seed": { "type": "integer", "minimum": 0 }
      }
    },
    "statistics_ms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_count", "minimum", "mean", "median", "p95", "standard_deviation"],
      "properties": {
        "sample_count": { "type": "integer", "minimum": 1 },
        "minimum": { "type": "number", "minimum": 0 },
        "mean": { "type": "number", "minimum": 0 },
        "median": { "type": "number", "minimum": 0 },
        "p95": { "type": "number", "minimum": 0 },
        "standard_deviation": { "type": "number", "minimum": 0 }
      }
    },
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "element_count",
        "failure_count",
        "worst_index",
        "max_absolute_error",
        "mean_absolute_error",
        "max_relative_error",
        "expected_at_worst",
        "actual_at_worst"
      ],
      "properties": {
        "passed": { "type": "boolean" },
        "element_count": { "type": "integer", "minimum": 0 },
        "failure_count": { "type": "integer", "minimum": 0 },
        "worst_index": { "type": "integer", "minimum": 0 },
        "max_absolute_error": { "$ref": "#/$defs/numberOrNull" },
        "mean_absolute_error": { "$ref": "#/$defs/numberOrNull" },
        "max_relative_error": { "$ref": "#/$defs/numberOrNull" },
        "expected_at_worst": { "$ref": "#/$defs/numberOrNull" },
        "actual_at_worst": { "$ref": "#/$defs/numberOrNull" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/numberOrNull" }
    },
    "samples_ms": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "number", "minimum": 0 }
    }
  },
  "$defs": {
    "dim3": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 0 },
        { "type": "integer", "minimum": 0 },
        { "type": "integer", "minimum": 0 }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "numberOrNull": {
      "type": ["number", "null"]
    }
  }
}
